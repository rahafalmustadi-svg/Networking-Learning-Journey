## How — Router configuration

enable
configure terminal
hostname HQ-Router
interface GigabitEthernet0/0
ip address 192.168.1.1 255.255.255.0
no shutdown
exit

ip dhcp excluded-address 192.168.1.1 192.168.1.9 
ip dhcp excluded-address 192.168.1.200 192.168.1.254 
ip dhcp pool LAN-POOL
network 192.168.1.0 255.255.255.0 
default-router 192.168.1.1 
dns-server 8.8.8.8 
exit 

## How — Switch configuration
enable 
configure terminal
hostname HQ-Switch 
interface fastEthernet0/1 
description Uplink to HQ-Router 
exit 
interface range fastEthernet0/2 - 7 
description LAN device port 
exit
interface vlan 1
ip address 192.168.1.2 255.255.255.0 
no shutdown 
exit
enable secret cisco123
line console 0
password cisco123 
login
exit
##Why static IPs for printer/server?
DHCP-assigned addresses can change on lease renewal, which breaks saved shortcuts (like a printer connection on every PC). Servers and printers get static IPs so their address never changes — standard practice in every real office network.
